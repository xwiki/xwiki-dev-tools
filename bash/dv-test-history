DEFAULT_DAYS = 28
OUTCOMES = ("passed", "failed", "flaky", "skipped", "notSelected")
# Outcomes that mean "the test ran and we know whether it worked".
RUN_OUTCOMES = ("passed", "failed", "flaky")
SQL_CHUNK = 900  # the query API caps result sets at 1000 rows
MAX_GROUP_COLUMNS = 12  # keep the per-tag and per-week tables readable
MAX_SUGGESTIONS = 10  # ready-to-run commands printed by --recent-failures
USER_AGENT = "dv-test-history/1.0"


