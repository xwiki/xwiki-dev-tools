# Tags -> configuration dimensions
# --------------------------------------------------------------------------- #

BROWSERS = ("firefox", "chrome", "edge", "safari")
DATABASE_RE = re.compile(r"^(mysql|mariadb|postgresql|oracle|hsqldb|mssql|db2)\b", re.I)
SERVLET_RE = re.compile(r"^(tomcat|jetty|wildfly|glassfish)\b", re.I)
BRANCH_RE = re.compile(r"^(master|main|trunk|stable-[\w.]+|feature-.*|release-.*)$", re.I)
# Builds that carry no browser tag run the default browser, so they are counted
# as that browser -- telling them apart would only split the statistics of a
# browser-specific failure in two.
IMPLICIT_BROWSER = "firefox"


def dimensions(tags: list[str], jvm: str, host: str) -> dict[str, str]:
    """Split a tag set into the dimensions that matter for XWiki ITs."""
    browser = next((t for t in tags if t.lower() in BROWSERS), None)
    database = next((t for t in tags if DATABASE_RE.match(t)), None)
    servlet = next((t for t in tags if SERVLET_RE.match(t)), None)
    branch = next((t for t in tags if BRANCH_RE.match(t)), None)
    known = {t for t in (browser, database, servlet, branch) if t}
    other = sorted(t for t in tags if t not in known)

    servlet_jdk = ""
    if servlet:
        m = re.search(r"jdk(\d+)", servlet, re.I)
        servlet_jdk = f"jdk{m.group(1)}" if m else ""
    maven_jdk = ""
    if jvm:
        # e.g. "Eclipse Temurin OpenJDK 64-Bit Server VM 21.0.11+10-LTS" -> jdk21,
        # "... 1.8.0_402-b06" -> jdk8.
        m = re.search(r"\b(\d+)\.(\d+)\.\d+", jvm)
        if m:
            major, minor = m.group(1), m.group(2)
            maven_jdk = f"jdk{minor if major == '1' else major}"

    return {
        "branch": branch or "(none)",
        "browser": (browser or IMPLICIT_BROWSER).lower(),
        "database": database or "(unspecified)",
        "servlet container": servlet or "(unspecified)",
        "servlet jdk": servlet_jdk or "(unspecified)",
        "maven jdk": maven_jdk or "(unknown)",
        "other tags": ", ".join(other) or "(none)",
    }


DIMENSION_ORDER = ["branch", "browser", "database", "servlet container",
                   "servlet jdk", "maven jdk", "other tags"]
# Dimensions that make up the "configuration" a test ran in.
CONFIG_DIMENSIONS = ["branch", "browser", "database", "servlet container"]


def config_label(dim: dict[str, str]) -> str:
    return " / ".join(dim[d] for d in CONFIG_DIMENSIONS)


# --------------------------------------------------------------------------- #
# Jenkins artifacts (screenshots and videos)
# --------------------------------------------------------------------------- #

# The Develocity link that points at the Jenkins build that published the scan.
JENKINS_LINK_LABEL = "Jenkins build"
# The docker-based test framework saves a screenshot (and, when recording is
# enabled, a video) of every failing UI test as
# "<configuration>-<class>-<test>[<repetition>].png" / ".flv" (see
# DockerTestUtils#getResultFileLocation), where <configuration> is
# "<db>-<dbTag>-<jdbc>-<servletEngine>-<servletTag>-<browser>". The XWiki
# pipeline archives them as build artifacts (see the archiveArtifacts calls in
# xwikiBuild.groovy), which is where we read them from.
SCREENSHOT_EXTENSION = ".png"
VIDEO_EXTENSION = ".flv"
ARTIFACT_EXTENSIONS = (SCREENSHOT_EXTENSION, VIDEO_EXTENSION)
# Artifact listings are only cached for a day: Jenkins discards the artifacts of
# old builds, and a longer-lived cache would keep linking to files that are gone.
JENKINS_CACHE_TTL = 24 * 3600


class Jenkins:
    """Reads the artifacts archived by a Jenkins build.

    Jenkins is queried anonymously (ci.xwiki.org allows it) with one
    `api/json` request per build, which lists the artifacts of the whole
    pipeline build -- i.e. of every configuration it ran, not only the one of
    the build scan at hand, hence the per-configuration matching in
    `find_test_artifacts`.
    """

    def __init__(self, cache: Cache, verbose: bool = False, timeout: int = 30):
        self.cache = cache
        self.verbose = verbose
        self.timeout = timeout
        self.request_count = 0
        self._builds: dict[str, dict | None] = {}
        # Newest build (per job) whose artifacts Jenkins has already discarded.
        # Builds are discarded oldest first, so anything older than that in the
        # same job is gone too and not worth a request.
        self._discarded: dict[str, int] = {}

    def log(self, message: str) -> None:
        if self.verbose:
            print(f"[jenkins] {message}", file=sys.stderr)

    @staticmethod
    def _job(build_url: str) -> str:
        return build_url.rstrip("/").rsplit("/", 1)[0]

    def discarded(self, build_url: str, time_ms: int) -> bool:
        """Whether this build is known to be gone without asking Jenkins."""
        return time_ms <= self._discarded.get(self._job(build_url), -1)

    def _load(self, build_url: str) -> dict | None:
        """Return the build's artifact listing, `{'missing': True}` when Jenkins
        no longer has the build, or None when it could not be fetched."""
        entry = self.cache.get("jenkins", build_url)
        if entry and time.time() - entry.get("fetched", 0) < JENKINS_CACHE_TTL:
            return entry.get("build")
        tree = "artifacts[relativePath]"
        url = f"{build_url}api/json?tree={urllib.parse.quote(tree, safe='')}"
        request = urllib.request.Request(url, headers={
            "Accept": "application/json", "User-Agent": USER_AGENT})
        self.request_count += 1
        self.log(f"GET {url}")
        try:
            with urllib.request.urlopen(request, timeout=self.timeout) as response:
                data = json.loads(response.read())
            build = {"artifacts": [a.get("relativePath", "")
                                   for a in data.get("artifacts") or []]}
        except urllib.error.HTTPError as error:
            if error.code != 404:
                self.log(f"HTTP {error.code} for {build_url}")
                return None
            build = {"missing": True}
        except (urllib.error.URLError, ValueError, OSError) as error:
            self.log(f"failed to read {build_url}: {error}")
            return None
        self.cache.put("jenkins", build_url, {"fetched": time.time(), "build": build})
        return build

    def prefetch(self, builds: list[tuple[str, int]], jobs: int) -> None:
        """Fetch the listings of the passed (build URL, build time) pairs."""
        todo = [url for url in dict.fromkeys(url for url, _ in builds)
                if url not in self._builds]
        if not todo:
            return
        with ThreadPoolExecutor(max_workers=max(1, jobs)) as pool:
            for url, build in pool.map(lambda u: (u, self._load(u)), todo):
                self._builds[url] = build
        for url, time_ms in builds:
            build = self._builds.get(url)
            if build and build.get("missing"):
                job = self._job(url)
                self._discarded[job] = max(self._discarded.get(job, -1), time_ms)

    def build(self, build_url: str) -> dict | None:
        if build_url not in self._builds:
            self._builds[build_url] = self._load(build_url)
        return self._builds[build_url]

    @staticmethod
    def artifact_url(build_url: str, path: str) -> str:
        return f"{build_url}artifact/{urllib.parse.quote(path, safe='/$')}"


def normalise_artifact_test_name(name: str) -> str:
    """Turn a reported test case name into the name used in artifact names.

    Mirrors normalizeTestName() of the Jenkins pipeline: the framework names the
    file after the test *method*, so the parameter list (`foo(TestUtils)`) or the
    display name (`foo{...}`) that JUnit appends has to go, and the index of a
    parameterized invocation is written without its brackets (`foo[2]` ->
    `foo2`).
    """
    start = name.find("{")
    end = name.rfind("}")
    if start < 0:
        start = name.find("(")
        end = name.rfind(")")
    if start >= 0:
        name = (name[:start] + name[end + 1:]) if end > start else name[:start]
    return name.replace("[", "").replace("]", "")


def matches_artifact_name(file_name: str, pattern: str) -> bool:
    """Whether the file is the `<class>-<test>` one, i.e. the pattern is followed
    by a name boundary rather than by more test-name characters -- otherwise a
    test whose name is a prefix of another one (`saveDocument` vs
    `saveDocumentWithoutRights`) would match the other test's screenshot."""
    index = file_name.find(pattern)
    while index >= 0:
        end = index + len(pattern)
        if end >= len(file_name) or not (file_name[end].isalnum()
                                         or file_name[end] in "_$"):
            return True
        index = file_name.find(pattern, index + 1)
    return False


def config_tokens(tags: list[str]) -> list[str]:
    """The tag values that also appear in the artifact names, normalised the way
    the test framework writes them (`mysql latest` -> `mysql-latest`)."""
    picked = [next((t for t in tags if t.lower() in BROWSERS), None),
              next((t for t in tags if DATABASE_RE.match(t)), None),
              next((t for t in tags if SERVLET_RE.match(t)), None)]
    return [t.lower().replace(" ", "-") for t in picked if t]


def find_test_artifacts(artifacts: list[str], container: str, test_name: str,
                        tags: list[str]) -> dict[str, str] | None:
    """Find the screenshot and the video of one test execution.

    A pipeline build archives the artifacts of all the configurations it ran, so
    a test that failed in several of them has several screenshots in the same
    build; the configuration tags of the build scan (browser, database, servlet
    engine), which the file name carries too, tell them apart. When they don't
    (e.g. a screenshot of the legacy test framework, whose name has no
    configuration prefix) the match is only used when it is unambiguous.
    """
    # The name is built from the fully qualified class name, but the legacy test
    # framework used the simple one, so both are accepted.
    method = normalise_artifact_test_name(test_name)
    patterns = [f"{container}-{method}",
                f"{container.rsplit('.', 1)[-1]}-{method}"]
    # Keyed by file name without the extension, so that the screenshot and the
    # video of the same execution stay together, and so that the same file
    # archived from two directories counts once.
    stems: dict[str, dict[str, Any]] = {}
    for path in artifacts:
        file_name = path.rsplit("/", 1)[-1]
        extension = next((e for e in ARTIFACT_EXTENSIONS
                          if file_name.endswith(e)), None)
        if not extension:
            continue
        if not any(matches_artifact_name(file_name, p) for p in patterns):
            continue
        stem = stems.setdefault(file_name[:-len(extension)], {"paths": []})
        stem.setdefault(extension, path)
        stem["paths"].append(path)
    if not stems:
        return None
    tokens = config_tokens(tags)
    matching = [name for name, files in stems.items()
                if tokens and any(all(t in p.lower() for t in tokens)
                                  for p in files["paths"])]
    if len(matching) == 1:
        chosen = stems[matching[0]]
    elif len(stems) == 1:
        chosen = next(iter(stems.values()))
    else:
        # Several candidates and nothing to tell them apart: linking a
        # screenshot of the wrong configuration would be worse than linking none.
        return None
    return {"screenshot": chosen.get(SCREENSHOT_EXTENSION, ""),
            "video": chosen.get(VIDEO_EXTENSION, "")}


def artifact_candidates(members: list[dict]) -> list[dict]:
    """Order the occurrences of a failure so that the ones to look up first are
    the most recent, in as many different browsers and configurations as
    possible -- a screenshot of the same failure in Chrome and in Firefox says
    more than two screenshots of the same configuration."""
    remaining = sorted(members, key=lambda m: -m["time"])
    order: list[dict] = []
    browsers: set[str] = set()
    configs: set[str] = set()
    while remaining:
        pick = (next((m for m in remaining if m["dim"]["browser"] not in browsers
                      and m["config"] not in configs), None)
                or next((m for m in remaining if m["config"] not in configs), None)
                or remaining[0])
        remaining.remove(pick)
        order.append(pick)
        browsers.add(pick["dim"]["browser"])
        configs.add(pick["config"])
    return order


def attach_artifacts(jenkins: Jenkins, groups: list[dict], container: str,
                     limit: int, jobs: int) -> None:
    """Look up the archived screenshot and video of the most recent occurrences
    of each failure, and store them as `artifacts` on the group.

    Jenkins discards the artifacts of old builds, so an occurrence can well have
    none left; each round tries one more occurrence per failure that is still
    short of `limit` results, and there are a few more rounds than results
    wanted to absorb those misses without turning this into a crawl.
    """
    for group in groups:
        group["artifacts"] = []
        group["artifact_queue"] = artifact_candidates(group["executions"])
        group["artifact_attempts"] = 0
    for _ in range(limit + 2):
        batch = []
        for group in groups:
            if len(group["artifacts"]) >= limit:
                continue
            while group["artifact_queue"]:
                execution = group["artifact_queue"].pop(0)
                build_url = execution.get("jenkins") or ""
                if not build_url:
                    # Not a Jenkins build (e.g. a scan published by a local
                    # build), so there are no archived artifacts to look for.
                    continue
                if jenkins.discarded(build_url, execution["time"]):
                    # An older build of a job whose artifacts Jenkins already
                    # discarded: counted as looked at, but not worth a request.
                    group["artifact_attempts"] += 1
                    continue
                batch.append((group, execution, build_url))
                break
        if not batch:
            break
        jenkins.prefetch([(url, e["time"]) for _, e, url in batch], jobs)
        for group, execution, build_url in batch:
            group["artifact_attempts"] += 1
            build = jenkins.build(build_url)
            if not build or build.get("missing"):
                continue
            found = find_test_artifacts(build["artifacts"], container,
                                        execution["test"], execution["tags"])
            if not found:
                continue
            group["artifacts"].append({
                "time": execution["time"],
                "config": execution["config"],
                "scan_id": execution["scan_id"],
                "build_url": build_url,
                "screenshot": (Jenkins.artifact_url(build_url, found["screenshot"])
                               if found["screenshot"] else ""),
                "video": (Jenkins.artifact_url(build_url, found["video"])
                          if found["video"] else ""),
            })
    for group in groups:
        group["artifacts"].sort(key=lambda a: -a["time"])
        group.pop("artifact_queue", None)


