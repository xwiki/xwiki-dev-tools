def collect_executions(cases: list[dict], attributes: dict[str, dict],
                       test_filter: str | None) -> list[dict]:
    executions = []
    for case in cases:
        full_name = case.get("name", "")
        case_name = full_name.rsplit(".", 1)[-1] if full_name else ""
        if test_filter and case_name != test_filter:
            continue
        for outcome, scan_ids in (case.get("buildScanIdsByOutcome") or {}).items():
            if outcome == "notSelected":
                continue
            for scan_id in scan_ids:
                attrs = attributes.get(scan_id)
                if not attrs or not attrs.get("start_time"):
                    continue
                dim = dimensions(attrs["tags"], attrs.get("jvm", ""),
                                 attrs.get("host", ""))
                executions.append({
                    "scan_id": scan_id,
                    "test": case_name,
                    "outcome": outcome,
                    "time": attrs["start_time"],
                    "tags": attrs["tags"],
                    "jenkins": attrs.get("jenkins_url", ""),
                    "dim": dim,
                    "config": config_label(dim),
                })
    executions.sort(key=lambda e: e["time"])
    return executions


def attach_failures(dv: Develocity, cache: Cache, executions: list[dict],
                    container: str, args, jobs: int) -> None:
    failing = [e for e in executions if e["outcome"] in ("failed", "flaky")]
    wanted_by_scan: dict[str, set[tuple[str, str]]] = defaultdict(set)
    for execution in failing:
        wanted_by_scan[execution["scan_id"]].add((container, execution["test"]))

    def fetch(scan_id: str) -> tuple[str, dict]:
        return scan_id, fetch_build_test_failures(
            dv, cache, scan_id, wanted_by_scan[scan_id], args.max_failure_pages)

    results: dict[str, dict] = {}
    if wanted_by_scan:
        with ThreadPoolExecutor(max_workers=jobs) as pool:
            for scan_id, data in pool.map(fetch, list(wanted_by_scan)):
                results[scan_id] = data

    for execution in failing:
        data = results.get(execution["scan_id"]) or {"failures": [], "total": 0}
        mine = [f for f in data["failures"]
                if f.get("id", {}).get("suiteName") == container
                and f.get("id", {}).get("testName") == execution["test"]]
        execution["build_test_failures"] = data.get("total", 0)
        execution["co_failing"] = [
            f"{f.get('id',{}).get('suiteName','').rsplit('.',1)[-1]}."
            f"{f.get('id',{}).get('testName','')}"
            for f in data["failures"]
            if (f.get("id", {}).get("suiteName"), f.get("id", {}).get("testName"))
            != (container, execution["test"])]
        if not mine:
            execution["signature"] = "unknown"
            execution["message"] = ""
            execution["stack"] = ""
            execution["norm_message"] = "(failure details unavailable)"
            execution["norm_stack"] = ""
            execution["exception"] = "(unknown)"
            continue
        failure = mine[0]
        signature, norm_message, norm_stack = failure_signature(
            failure.get("message"), failure.get("stacktrace"),
            args.group_by, args.keep_line_numbers, execution["test"])
        execution["signature"] = signature
        execution["message"] = "\n".join(message_lines(failure.get("message")))
        execution["stack"] = "\n".join(stack_lines(failure.get("stacktrace")))
        execution["norm_message"] = norm_message
        execution["norm_stack"] = norm_stack
        execution["exception"] = exception_type(failure.get("message"))
        execution["raw_message"] = re.sub(
            r"\s+", " ", " ".join(l for l in message_lines(failure.get("message"))
                                  if not NOISE_LINE.match(l))).strip()
        execution["site"] = assertion_site(execution["stack"], container)
        # Stack-only signature, to spot groups that differ only in the message.
        execution["stack_signature"] = failure_signature(
            failure.get("message"), failure.get("stacktrace"), "stack",
            args.keep_line_numbers, execution["test"])[0]


def config_stats(executions: list[dict], group_filter: str | None = None) -> dict:
    """Timeline statistics for one configuration (optionally one failure group)."""
    runs = [e for e in executions if e["outcome"] in RUN_OUTCOMES]
    if group_filter:
        fails = [e for e in runs if e.get("signature") == group_filter]
    else:
        fails = [e for e in runs if e["outcome"] in ("failed", "flaky")]
    # A "pass" is always a genuinely successful execution, also when we look at a
    # single failure group -- otherwise failures of other groups would be counted
    # as successes here.
    passes = [e for e in runs if e["outcome"] == "passed"]
    fail_ids = {id(e) for e in fails}
    stats = {
        "runs": len(runs),
        "passed": sum(1 for e in runs if e["outcome"] == "passed"),
        "failed": sum(1 for e in runs if e["outcome"] == "failed"),
        "flaky": sum(1 for e in runs if e["outcome"] == "flaky"),
        "skipped": sum(1 for e in executions if e["outcome"] == "skipped"),
        "fail_count": len(fails),
        "first_fail": fails[0]["time"] if fails else None,
        "last_fail": fails[-1]["time"] if fails else None,
        "last_run": runs[-1] if runs else None,
        "first_fail_scan": fails[0]["scan_id"] if fails else None,
        "last_fail_scan": fails[-1]["scan_id"] if fails else None,
    }
    if fails:
        lo, hi = stats["first_fail"], stats["last_fail"]
        stats["pass_in_span"] = sum(1 for e in passes if lo <= e["time"] <= hi)
        stats["fail_in_span"] = len(fails)
        stats["pass_before"] = sum(1 for e in passes if e["time"] < lo)
        stats["pass_after"] = sum(1 for e in passes if e["time"] > hi)
        streak, best = 0, 0
        for e in runs:
            if id(e) in fail_ids:
                streak += 1
                best = max(best, streak)
            else:
                streak = 0
        stats["longest_streak"] = best
    else:
        stats.update(pass_in_span=0, fail_in_span=0, pass_before=len(passes),
                     pass_after=0, longest_streak=0)
    return stats


def dimension_breakdown(runs: list[dict]) -> dict[str, dict]:
    """Group executions by each tag dimension, flagging useless dimensions."""
    breakdown: dict[str, dict] = {}
    for dimension in DIMENSION_ORDER:
        values: dict[str, list[dict]] = defaultdict(list)
        for execution in runs:
            values[execution["dim"][dimension]].append(execution)
        breakdown[dimension] = {
            "values": dict(values),
            # A dimension with almost as many values as executions (typically a
            # per-container host name) cannot tell us anything.
            "too_granular": len(values) > max(6, len(runs) / 4),
        }
    return breakdown


def tag_signals(runs: list[dict], groups: list[dict],
                breakdown: dict[str, dict]) -> list[dict]:
    """Tag values in which one failure group is significantly over-represented.

    Signals whose failing executions are a subset of an already accepted,
    stronger signal are dropped: they are correlates of it (e.g. `tomcat`, which
    is only ever used together with `chrome`) rather than independent findings.
    """
    candidates: list[dict] = []
    for dimension, data in breakdown.items():
        if data["too_granular"]:
            continue
        for value, subset in data["values"].items():
            if len(subset) == len(runs):
                continue
            subset_ids = {id(e) for e in subset}
            for group in groups:
                hits = [e for e in group["executions"] if id(e) in subset_ids]
                a, total = len(hits), len(group["executions"])
                threshold = 0.05 if a == total else 0.01
                if a < 3 or (a < 5 and a != total):
                    continue
                p = fisher_enrichment(a, len(subset) - a, total - a,
                                      len(runs) - len(subset) - (total - a))
                if p >= threshold:
                    continue
                candidates.append({
                    "group": group["label"], "dimension": dimension,
                    "value": value, "hits": a, "total": total, "p": p,
                    "share_of_runs": len(subset) / len(runs),
                    "scans": frozenset(e["scan_id"] for e in hits),
                })
    accepted: list[dict] = []
    per_group: dict[str, list[frozenset]] = defaultdict(list)
    for candidate in sorted(candidates, key=lambda c: c["p"]):
        if any(candidate["scans"] <= seen for seen in per_group[candidate["group"]]):
            continue
        per_group[candidate["group"]].append(candidate["scans"])
        accepted.append(candidate)
    return accepted


def key_findings(ordered: list[dict], by_config: dict[str, list[dict]],
                 signals: list[dict], change: dict | None, fails: list[dict],
                 runs: list[dict], to_ms: int, tz,
                 multi_case: bool = False) -> list[str]:
    """A handful of sentences summarising what the tables below show."""
    if not fails:
        return [f"No failure in {len(runs)} executions in this window."]
    findings = []

    def name(group: dict) -> str:
        test = group["executions"][0]["test"]
        return (f"{group['label']} (`{test}`, `{group['exception']}`)" if multi_case
                else f"{group['label']}")

    top = ordered[0]
    if len(ordered) == 1:
        findings.append(f"A single distinct failure (`{top['exception']}`), "
                        f"{len(top['executions'])} occurrences.")
    else:
        findings.append(
            f"{len(ordered)} distinct failures; {name(top)} accounts "
            f"for {pct(len(top['executions']), len(fails))} of all "
            f"{len(fails)} failures.")
    for group in ordered[:3]:
        exclusive = [s for s in signals
                     if s["group"] == group["label"] and s["hits"] == s["total"]]
        if exclusive:
            best = exclusive[0]
            findings.append(f"{name(group)} happens **only** with "
                            f"`{best['dimension']} = {best['value']}` "
                            f"({best['share_of_runs'] * 100:.0f}% of runs, "
                            f"p={best['p']:.1g}).")
        else:
            partial = [s for s in signals if s["group"] == group["label"]]
            if partial:
                findings.append(f"{name(group)} is concentrated on "
                                f"`{partial[0]['dimension']} = "
                                f"{partial[0]['value']}` "
                                f"({partial[0]['hits']}/{partial[0]['total']} of its "
                                f"failures, p={partial[0]['p']:.1g}).")
    if change and change["p_adjusted"] < 0.05:
        before = change["before_fails"] / change["before_runs"]
        after = change["after_fails"] / change["after_runs"]
        verb = "rose" if after > before else "dropped"
        findings.append(
            f"The failure rate {verb} around **{fmt_date(change['cut'], tz)}**: "
            f"{pct(change['before_fails'], change['before_runs'])} before vs "
            f"{pct(change['after_fails'], change['after_runs'])} after "
            f"(p={change['p_adjusted']:.1g}, adjusted).")
    affected = [config for config, subset in by_config.items()
                if any(e["outcome"] in ("failed", "flaky") for e in subset)]
    broken_now = [config for config in affected
                  if (config_stats(by_config[config])["last_run"] or {})
                  .get("outcome") in ("failed", "flaky")]
    findings.append(f"Failed in {len(affected)} of {len(by_config)} configurations; "
                    f"the most recent run failed in {len(broken_now)} of them"
                    + (": " + ", ".join(f"`{c}`" for c in sorted(broken_now)[:6])
                       + (" …" if len(broken_now) > 6 else "")
                       if broken_now else "."))
    # Judge the quiet streak only over the configurations that ever failed: a
    # chrome-only failure cannot be contradicted by clean firefox runs.
    scoped = [e for e in runs if e["config"] in set(affected)]
    findings.append(quiet_streak_finding(fails, scoped, len(affected), to_ms))
    return findings


def quiet_streak_finding(fails: list[dict], scoped_runs: list[dict],
                         config_count: int, to_ms: int) -> str:
    """State what the clean runs since the last failure are actually worth.

    A handful of passes after a failure means nothing for a test that fails a few
    percent of the time, so instead of guessing "fixed" this reports how likely
    the quiet streak is under the failure rate observed in the configurations
    that are affected at all, and how long a streak would have to be to mean
    something.
    """
    days_quiet = (to_ms - fails[-1]["time"]) / 86400000
    since = sum(1 for e in scoped_runs if e["time"] > fails[-1]["time"])
    where = (f"in the {config_count} affected configurations"
             if config_count > 1 else "in the affected configuration")
    text = (f"Last failure {days_quiet:.1f} days ago, {since} clean "
            f"run{'' if since == 1 else 's'} {where} since then")
    rate = len(fails) / len(scoped_runs) if scoped_runs else 1.0
    if rate >= 1.0:
        return text + " — every execution there failed."
    # Probability of a streak this long if the failure rate had not changed.
    probability = (1 - rate) ** since
    needed = math.ceil(math.log(0.05) / math.log(1 - rate))
    if since and probability < 0.05:
        return (text + f" — a streak that long is unlikely (p={probability:.2g}) at "
                f"the {rate * 100:.1f}% failure rate seen there, so the failure "
                f"plausibly stopped.")
    return (text + f" — at the {rate * 100:.1f}% failure rate seen there that is no "
            f"evidence of a fix (p={probability:.2g}); about {needed} consecutive "
            f"clean runs would be needed to conclude the failure stopped.")


def describe_signal(signal: dict) -> str:
    scope = (f"all {signal['total']}" if signal["hits"] == signal["total"]
             else f"{signal['hits']} of {signal['total']}")
    return (f"{signal['group']}: {scope} failures on "
            f"`{signal['dimension']} = {signal['value']}` "
            f"({signal['share_of_runs'] * 100:.1f}% of runs), p={signal['p']:.2g}")


def weekly_buckets(executions: list[dict], to_ms: int, weeks: int) -> list[dict]:
    buckets = []
    week_ms = 7 * 24 * 3600 * 1000
    for index in range(weeks):
        hi = to_ms - index * week_ms
        lo = hi - week_ms
        inside = [e for e in executions if lo <= e["time"] < hi
                  and e["outcome"] in RUN_OUTCOMES]
        buckets.append({"lo": lo, "hi": hi, "executions": inside})
    return list(reversed(buckets))


def rolling_rates(executions: list[dict], frm_ms: int, to_ms: int,
                  window_days: int = 7) -> list[dict]:
    day = 24 * 3600 * 1000
    window = window_days * day
    points = []
    hi = frm_ms + window
    while hi <= to_ms + day:
        lo = hi - window
        inside = [e for e in executions if lo <= e["time"] < hi
                  and e["outcome"] in RUN_OUTCOMES]
        fails = sum(1 for e in inside if e["outcome"] in ("failed", "flaky"))
        points.append({"hi": hi, "runs": len(inside), "fails": fails,
                       "rate": (fails / len(inside)) if inside else 0.0})
        hi += day
    return points


def best_change_point(executions: list[dict], min_side: int = 20) -> dict | None:
    """Find the split in time where the failure rate changes most significantly."""
    runs = [e for e in executions if e["outcome"] in RUN_OUTCOMES]
    if len(runs) < 2 * min_side:
        return None
    total_fails = sum(1 for e in runs if e["outcome"] in ("failed", "flaky"))
    if total_fails == 0:
        return None
    day = 24 * 3600 * 1000
    days = sorted({e["time"] // day for e in runs})
    candidates = []
    for boundary in days[1:]:
        cut = boundary * day
        before = [e for e in runs if e["time"] < cut]
        after = [e for e in runs if e["time"] >= cut]
        if len(before) < min_side or len(after) < min_side:
            continue
        f1 = sum(1 for e in before if e["outcome"] in ("failed", "flaky"))
        f2 = sum(1 for e in after if e["outcome"] in ("failed", "flaky"))
        p = fisher_two_proportions(f1, len(before), f2, len(after))
        candidates.append({"cut": cut, "before_fails": f1, "before_runs": len(before),
                           "after_fails": f2, "after_runs": len(after), "p": p,
                           "tests": 0})
    if not candidates:
        return None
    best = min(candidates, key=lambda c: c["p"])
    best["tests"] = len(candidates)
    best["p_adjusted"] = min(1.0, best["p"] * len(candidates))
    return best


