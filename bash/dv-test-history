# Statistics helpers
# --------------------------------------------------------------------------- #

def fisher_enrichment(a: int, b: int, c: int, d: int) -> float:
    """One-sided Fisher exact test p-value for enrichment of `a`.

    Contingency table:  [[a, b], [c, d]]  -- rows are the group of interest vs
    the rest, columns are failure vs no failure.  Returns P(X >= a).
    """
    n = a + b + c + d
    if n == 0 or (a + c) == 0 or (a + b) == 0:
        return 1.0
    row1, col1 = a + b, a + c
    hi = min(row1, col1)
    denominator = math.comb(n, row1)
    numerator = sum(math.comb(col1, k) * math.comb(n - col1, row1 - k)
                    for k in range(a, hi + 1))
    return min(1.0, numerator / denominator)


def fisher_two_proportions(f1: int, n1: int, f2: int, n2: int) -> float:
    """Two-sided-ish p-value for "failure rate differs between two samples".

    Uses the smaller of the two one-sided Fisher tests, doubled and clamped --
    good enough to flag interesting changes without pulling in scipy.
    """
    a, b, c, d = f1, n1 - f1, f2, n2 - f2
    if min(n1, n2) == 0:
        return 1.0
    p_up = fisher_enrichment(a, b, c, d)
    p_down = fisher_enrichment(c, d, a, b)
    return min(1.0, 2 * min(p_up, p_down))


def sparkline(values: Iterable[float]) -> str:
    values = list(values)
    if not values:
        return ""
    blocks = "▁▂▃▄▅▆▇█"
    top = max(values)
    if top <= 0:
        return "▁" * len(values)
    return "".join(blocks[min(len(blocks) - 1, int(v / top * (len(blocks) - 1) + 0.5))]
                   for v in values)


