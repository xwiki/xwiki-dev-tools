# Credentials
# --------------------------------------------------------------------------- #

def _bearer(value: str) -> str | None:
    """Extract the token from an `Authorization` header value."""
    m = re.search(r"Bearer\s+(\S+)", value)
    if m:
        return m.group(1)
    return value.strip() or None


def _credentials_from_git_config() -> tuple[str | None, str | None]:
    """The bearer token git uses for the Develocity agent skills repository."""
    try:
        out = subprocess.run(
            ["git", "config", "--get-regexp", r"^http\..*\.extraheader$"],
            capture_output=True, text=True, check=False).stdout
    except OSError:
        return None, None
    for line in out.splitlines():
        key, _, value = line.partition(" ")
        m = re.match(r"^http\.(https?://[^/]+)/.*\.extraheader$", key)
        if not m:
            continue
        host = m.group(1)
        bearer = re.search(r"Bearer\s+(\S+)", value)
        if bearer and _looks_like_develocity(host):
            return host, bearer.group(1)
    return None, None


def _looks_like_develocity(text: str) -> bool:
    text = text.lower()
    return "develocity" in text or "gradle" in text


def _claude_config_files() -> list[str]:
    """Files where Claude Code stores MCP server definitions, most specific first."""
    paths = []
    config_dir = os.environ.get("CLAUDE_CONFIG_DIR")
    if config_dir:
        paths.append(os.path.join(config_dir, ".claude.json"))
    home = os.path.expanduser("~")
    paths += [os.path.join(home, ".claude", ".claude.json"),
              os.path.join(home, ".claude.json"),
              # Project-scoped servers, checked into the repository.
              os.path.join(os.getcwd(), ".mcp.json")]
    seen, unique = set(), []
    for path in paths:
        if path not in seen:
            seen.add(path)
            unique.append(path)
    return unique


def _iter_mcp_servers(data: Any) -> Iterable[tuple[str, dict]]:
    """Yield the (name, definition) of every MCP server in a Claude config."""
    if not isinstance(data, dict):
        return
    sections = [data.get("mcpServers")]
    projects = data.get("projects")
    if isinstance(projects, dict):
        sections += [p.get("mcpServers") for p in projects.values()
                     if isinstance(p, dict)]
    for section in sections:
        if isinstance(section, dict):
            for name, definition in section.items():
                if isinstance(definition, dict):
                    yield name, definition


def _credentials_from_claude_config() -> tuple[str | None, str | None]:
    """The URL and bearer token of the Develocity MCP server in Claude's config.

    Claude Code stores remote MCP servers as
    `mcpServers.<name> = {"url": "https://.../mcp", "headers": {"Authorization":
    "Bearer ..."}}`, either globally in `.claude.json` or per project (there and
    in a `.mcp.json` next to the sources).
    """
    for path in _claude_config_files():
        try:
            with open(path, encoding="utf-8") as handle:
                data = json.load(handle)
        except (OSError, ValueError):
            continue
        for name, server in _iter_mcp_servers(data):
            server_url = server.get("url") or ""
            if not isinstance(server_url, str):
                continue
            if not _looks_like_develocity(f"{name} {server_url}"):
                continue
            headers = server.get("headers")
            token = None
            if isinstance(headers, dict):
                for key, value in headers.items():
                    if key.lower() == "authorization" and isinstance(value, str):
                        token = _bearer(value)
            if not token:
                continue
            # The MCP endpoint lives below the Develocity base URL.
            return re.sub(r"/mcp/?$", "", server_url) or None, token
    return None, None


def resolve_credentials(url: str | None, token: str | None) -> tuple[str, str]:
    url = url or os.environ.get("DEVELOCITY_URL")
    token = token or os.environ.get("DEVELOCITY_ACCESS_KEY")

    for source in (_credentials_from_git_config, _credentials_from_claude_config):
        if url and token:
            break
        found_url, found_token = source()
        url, token = url or found_url, token or found_token

    if url and token:
        return url.rstrip("/"), token

    raise SystemExit(
        "Could not determine Develocity credentials. Set DEVELOCITY_URL and "
        "DEVELOCITY_ACCESS_KEY, or pass --server/--token.")


