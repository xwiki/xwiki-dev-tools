# Target / time window parsing
# --------------------------------------------------------------------------- #

def parse_target(target: str) -> tuple[str, str | None, str | None, str | None]:
    """Return (container, test_name, project_glob, relative_window) from a
    Develocity tests URL or a `container[#test]` string."""
    if target.startswith("http://") or target.startswith("https://"):
        query = urllib.parse.parse_qs(urllib.parse.urlparse(target).query)
        container = (query.get("tests.container") or [None])[0]
        if not container:
            raise SystemExit("URL does not contain a 'tests.container' parameter")
        test = (query.get("tests.test") or [None])[0]
        project = (query.get("search.rootProjectNames") or [None])[0]
        window = (query.get("search.relativeStartTime") or [None])[0]
        return container, test, project, window
    container, sep, test = target.partition("#")
    return container, (test or None), None, None


def parse_iso_duration_days(value: str) -> float | None:
    """Very small ISO-8601 duration parser, enough for P28D / P4W / PT48H."""
    m = re.fullmatch(r"P(?:(\d+)W)?(?:(\d+)D)?(?:T(?:(\d+)H)?(?:(\d+)M)?)?", value)
    if not m:
        return None
    weeks, days, hours, minutes = (int(g) if g else 0 for g in m.groups())
    total = weeks * 7 + days + hours / 24 + minutes / 1440
    return total or None


def with_timezone(value: str, tz) -> dt.datetime:
    parsed = dt.datetime.fromisoformat(value)
    return parsed if parsed.tzinfo else parsed.replace(tzinfo=tz)


def resolve_window(args, url_window: str | None, tz) -> tuple[dt.datetime, dt.datetime]:
    now = dt.datetime.now(tz)
    to = with_timezone(args.to, tz) if args.to else now
    if args.since:
        frm = with_timezone(args.since, tz)
    else:
        days = args.days
        if days is None and url_window:
            days = parse_iso_duration_days(url_window)
        days = days if days is not None else DEFAULT_DAYS
        frm = to - dt.timedelta(days=days)
    if frm >= to:
        raise SystemExit("Empty time window: --since must be before --to")
    return frm, to


