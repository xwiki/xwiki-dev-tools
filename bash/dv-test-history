class Report:
    def __init__(self) -> None:
        self.parts: list[str] = []

    def line(self, text: str = "") -> None:
        self.parts.append(text)

    def table(self, headers: list[str], rows: list[list[str]],
              aligns: str | None = None) -> None:
        if not rows:
            self.line("_(no data)_")
            self.line()
            return
        cells = [[str(c) for c in row] for row in rows]
        widths = [max(len(headers[i]), *(len(r[i]) for r in cells))
                  for i in range(len(headers))]
        aligns = aligns or "l" * len(headers)

        def fmt(row: list[str]) -> str:
            out = []
            for i, value in enumerate(row):
                out.append(value.ljust(widths[i]) if aligns[i] == "l"
                           else value.rjust(widths[i]))
            return "| " + " | ".join(out) + " |"

        self.line(fmt(headers))
        self.line("|" + "|".join(
            ("-" * (w + 2)) if aligns[i] == "l" else ("-" * (w + 1) + ":")
            for i, w in enumerate(widths)) + "|")
        for row in cells:
            self.line(fmt(row))
        self.line()

    def __str__(self) -> str:
        return "\n".join(self.parts) + "\n"


def pct(part: int, whole: int) -> str:
    return f"{100.0 * part / whole:.1f}%" if whole else "-"


def fmt_time(ms: int | None, tz) -> str:
    if not ms:
        return "-"
    return dt.datetime.fromtimestamp(ms / 1000, tz).strftime("%Y-%m-%d %H:%M")


def fmt_date(ms: int | None, tz) -> str:
    if not ms:
        return "-"
    return dt.datetime.fromtimestamp(ms / 1000, tz).strftime("%Y-%m-%d")


def truncate(text: str, limit: int) -> str:
    return text if len(text) <= limit else text[:limit - 1] + "…"


