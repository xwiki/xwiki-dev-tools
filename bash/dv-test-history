class DevelocityError(RuntimeError):
    """A request to Develocity failed."""


class Develocity:
    """Thin client for the Develocity REST API and its MCP endpoint."""

    def __init__(self, base_url: str, token: str, verbose: bool = False):
        self.base_url = base_url
        self.token = token
        self.verbose = verbose
        self.request_count = 0

    def _open(self, req: urllib.request.Request, attempts: int = 4) -> bytes:
        delay = 2.0
        for attempt in range(1, attempts + 1):
            self.request_count += 1
            try:
                with urllib.request.urlopen(req, timeout=120) as resp:
                    return resp.read()
            except urllib.error.HTTPError as e:
                body = e.read().decode("utf-8", "replace")
                retryable = e.code in (429, 500, 502, 503, 504)
                if not retryable or attempt == attempts:
                    raise DevelocityError(
                        f"{req.get_method()} {req.full_url.split('?')[0]} failed "
                        f"with HTTP {e.code}: {body[:500]}")
                self.log(f"HTTP {e.code}, retrying in {delay:.0f}s")
            except urllib.error.URLError as e:
                if attempt == attempts:
                    raise DevelocityError(f"Network error talking to Develocity: {e}")
                self.log(f"network error ({e}), retrying in {delay:.0f}s")
            time.sleep(delay)
            delay *= 2
        raise AssertionError("unreachable")

    def log(self, message: str) -> None:
        if self.verbose:
            print(f"[dv] {message}", file=sys.stderr)

    def get(self, path: str, params: list[tuple[str, str]]) -> Any:
        url = f"{self.base_url}{path}?{urllib.parse.urlencode(params)}"
        self.log(f"GET {path} {params}")
        req = urllib.request.Request(url, headers={
            "Authorization": f"Bearer {self.token}",
            "Accept": "application/json",
            "User-Agent": USER_AGENT,
        })
        return json.loads(self._open(req))

    def mcp(self, tool: str, arguments: dict) -> str:
        """Call an MCP tool over plain HTTP JSON-RPC and return its text content.

        The Develocity MCP endpoint is stateless, so no initialize handshake is
        needed. This is how we reach data the REST API does not expose (test
        failure messages and stack traces, and the DRV query API).
        """
        payload = {
            "jsonrpc": "2.0", "id": 1, "method": "tools/call",
            "params": {"name": tool, "arguments": arguments},
        }
        self.log(f"MCP {tool} {json.dumps(arguments)[:160]}")
        req = urllib.request.Request(
            f"{self.base_url}/mcp", data=json.dumps(payload).encode(),
            headers={
                "Authorization": f"Bearer {self.token}",
                "Content-Type": "application/json",
                "Accept": "application/json, text/event-stream",
                "User-Agent": USER_AGENT,
            }, method="POST")
        raw = self._open(req).decode("utf-8", "replace")
        if raw.startswith("event:") or raw.startswith("data:"):  # SSE framing
            raw = "\n".join(l[5:].strip() for l in raw.splitlines()
                            if l.startswith("data:"))
        response = json.loads(raw)
        if "error" in response:
            raise DevelocityError(f"MCP {tool} failed: {response['error']}")
        result = response["result"]
        text = "".join(c.get("text", "") for c in result.get("content", []))
        if result.get("isError"):
            raise DevelocityError(f"MCP {tool} failed: {text[:800]}")
        return text

    def sql(self, query: str) -> list[dict[str, str]]:
        text = self.mcp("execute_query", {"query": query})
        rows = list(csv.DictReader(io.StringIO(text)))
        return rows


class Cache:
    """Disk cache for immutable per-build-scan data."""

    def __init__(self, directory: str | None):
        self.dir = directory
        if self.dir:
            os.makedirs(self.dir, exist_ok=True)

    def _path(self, kind: str, key: str) -> str:
        assert self.dir
        digest = hashlib.sha1(key.encode()).hexdigest()[:16]
        return os.path.join(self.dir, f"{kind}-{digest}.json")

    def get(self, kind: str, key: str) -> Any | None:
        if not self.dir:
            return None
        try:
            with open(self._path(kind, key)) as fh:
                return json.load(fh)
        except (OSError, ValueError):
            return None

    def put(self, kind: str, key: str, value: Any) -> None:
        if not self.dir:
            return
        path = self._path(kind, key)
        try:
            with open(path + ".tmp", "w") as fh:
                json.dump(value, fh)
            os.replace(path + ".tmp", path)
        except OSError:
            pass


