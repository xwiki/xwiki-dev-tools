# CLI
# --------------------------------------------------------------------------- #

def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="dv-test-history",
        description="Analyse the failure history of a test using Develocity.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="TARGET is a test container FQN, 'Container#testCase', or a "
               "Develocity /scans/tests URL.")
    parser.add_argument("target", nargs="?",
                        help="test container FQN, 'Container#testCase', or a "
                             "Develocity /scans/tests URL; omit it together with "
                             "--recent-failures")
    parser.add_argument("--recent-failures", nargs="?", type=float, const=24,
                        default=None, metavar="HOURS",
                        help="instead of analysing one test, list the tests that "
                             "failed in the last HOURS (default 24) as candidates "
                             "for an analysis")
    parser.add_argument("--baseline-days", type=float, default=14, metavar="DAYS",
                        help="with --recent-failures, how far back to look to tell "
                             "a new failure from a known one (0 to skip, saves one "
                             "request per container; default 14)")
    parser.add_argument("--test", help="test case name (overrides the one in TARGET)")
    parser.add_argument("--days", type=float, default=None,
                        help=f"length of the window in days (default {DEFAULT_DAYS})")
    parser.add_argument("--since", help="window start, ISO date/datetime")
    parser.add_argument("--to", help="window end, ISO date/datetime (default: now)")
    parser.add_argument("--project", default=None,
                        help="root project name filter, wildcards allowed "
                             "(default: XWiki*)")
    parser.add_argument("--query", help="extra Develocity build query terms")
    parser.add_argument("--tz", default=None,
                        help="timezone for displayed times (default: local)")
    parser.add_argument("--group-by", choices=("message+stack", "stack", "message"),
                        default="message+stack",
                        help="what makes two failures the same (default message+stack)")
    parser.add_argument("--keep-line-numbers", action="store_true",
                        help="keep source line numbers in stack frames; by default "
                             "they are stripped so the same failure groups across "
                             "branches")
    parser.add_argument("--max-failure-pages", type=int, default=6,
                        help="how many pages of test failures to read per build "
                             "when looking for this test (20 per page, default 6)")
    parser.add_argument("--top-scans", type=int, default=8,
                        help="build scan links to list per failure group")
    parser.add_argument("--artifacts", type=int, default=3, metavar="N",
                        help="how many recent occurrences of each failure to look "
                             "up on Jenkins for an archived screenshot and video "
                             "(default 3, 0 to skip Jenkins entirely)")
    parser.add_argument("--max-variants", type=int, default=12,
                        help="distinct raw messages to list per failure group "
                             "(default 12)")
    parser.add_argument("--variant-chars", type=int, default=220,
                        help="how much of each raw message to show in the variant "
                             "table (default 220)")
    parser.add_argument("--message-chars", type=int, default=1200)
    parser.add_argument("--stack-chars", type=int, default=2500)
    parser.add_argument("--jobs", type=int, default=6,
                        help="parallel requests for failure details (default 6)")
    parser.add_argument("--no-cache", action="store_true")
    parser.add_argument("--cache-dir", default=None)
    parser.add_argument("--json", dest="json_out",
                        help="also write the raw analysis as JSON to this file")
    parser.add_argument("-o", "--output", help="write the report to this file")
    parser.add_argument("--server", help="Develocity base URL")
    parser.add_argument("--token", help="Develocity access key")
    parser.add_argument("-v", "--verbose", action="store_true")
    args = parser.parse_args(argv)

    if args.target is None and args.recent_failures is None:
        parser.error("either TARGET or --recent-failures is required")
    if args.target is not None and args.recent_failures is not None:
        parser.error("--recent-failures lists all failing tests, so it cannot be "
                     "combined with a TARGET")
    container, url_test, url_project, url_window = parse_target(args.target or "")
    test_filter = args.test or url_test
    project = args.project or url_project or "XWiki*"

    if args.tz and ZoneInfo:
        tz = ZoneInfo(args.tz)
    else:
        tz = dt.datetime.now().astimezone().tzinfo
    if args.recent_failures is not None and not (args.since or args.days):
        args.days = args.recent_failures / 24
    frm, to = resolve_window(args, url_window, tz)

    base_url, token = resolve_credentials(args.server, args.token)
    dv = Develocity(base_url, token, args.verbose)
    cache_dir = None if args.no_cache else (
        args.cache_dir or os.path.join(
            os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")),
            "dv-test-history"))
    cache = Cache(cache_dir)

    if args.recent_failures is not None:
        text = report_recent_failures(dv, cache, args, frm, to, tz, project)
        if args.output:
            with open(args.output, "w") as fh:
                fh.write(text)
            print(f"Report written to {args.output}", file=sys.stderr)
        else:
            sys.stdout.write(text)
        return 0

    query = build_query(frm, to, project, args.query)
    cases = fetch_test_cases(dv, container, query)
    if not cases:
        print(f"No test cases found for container {container!r} in the window "
              f"(query: {query}).", file=sys.stderr)
        return 1
    scan_ids = sorted({scan_id for case in cases
                       for ids in (case.get("buildScanIdsByOutcome") or {}).values()
                       for scan_id in ids})
    dv.log(f"{len(cases)} test case(s), {len(scan_ids)} build scans")
    attributes = fetch_build_attributes(dv, cache, scan_ids, frm, to)
    executions = collect_executions(cases, attributes, test_filter)
    if test_filter and not executions:
        known = sorted({c["name"].rsplit(".", 1)[-1] for c in cases})
        print(f"No executions of test {test_filter!r} found. Known test cases in "
              f"this container: {', '.join(known)}", file=sys.stderr)
        return 1
    attach_failures(dv, cache, executions, container, args, args.jobs)

    jenkins = Jenkins(cache, args.verbose)
    text, machine = render(dv, jenkins, args, container, test_filter, cases,
                           executions, frm, to, tz, query)
    if args.output:
        with open(args.output, "w") as fh:
            fh.write(text)
        print(f"Report written to {args.output}", file=sys.stderr)
    else:
        sys.stdout.write(text)
    if args.json_out:
        with open(args.json_out, "w") as fh:
            json.dump(machine, fh, indent=1, default=str)
        print(f"JSON written to {args.json_out}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except DevelocityError as error:
        sys.exit(f"dv-test-history: {error}")
    except KeyboardInterrupt:
        sys.exit(130)
