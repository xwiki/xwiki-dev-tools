# Report
# --------------------------------------------------------------------------- #

def render(dv: Develocity, jenkins: Jenkins, args, container: str,
           test_filter: str | None, cases: list[dict], executions: list[dict],
           frm: dt.datetime, to: dt.datetime, tz, query: str) -> tuple[str, dict]:
    report = Report()
    runs = [e for e in executions if e["outcome"] in RUN_OUTCOMES]
    fails = [e for e in runs if e["outcome"] in ("failed", "flaky")]
    scan_url = f"{dv.base_url}/s/"
    to_ms = int(to.timestamp() * 1000)
    frm_ms = int(frm.timestamp() * 1000)

    # ---- analysis, before anything is written, so the summary can come first ----
    groups: dict[str, dict] = {}
    for execution in fails:
        signature = execution.get("signature", "unknown")
        group = groups.setdefault(signature, {
            "signature": signature, "executions": [],
            "exception": execution.get("exception", "(unknown)"),
        })
        group["executions"].append(execution)
    ordered = sorted(groups.values(), key=lambda g: (-len(g["executions"]),
                                                     g["executions"][0]["time"]))
    for index, group in enumerate(ordered, start=1):
        group["label"] = f"F{index}"
    if args.artifacts > 0 and ordered:
        attach_artifacts(jenkins, ordered, container, args.artifacts, args.jobs)
    shown_groups = ordered[:MAX_GROUP_COLUMNS]
    by_config: dict[str, list[dict]] = defaultdict(list)
    for execution in executions:
        by_config[execution["config"]].append(execution)
    breakdown = dimension_breakdown(runs)
    signals = tag_signals(runs, ordered, breakdown) if fails else []
    change = best_change_point(executions) if fails else None

    title = container + (f"#{test_filter}" if test_filter else "")
    report.line(f"# Test failure history — `{title}`")
    report.line()
    report.line(f"* Window: **{frm.strftime('%Y-%m-%d %H:%M')} → "
                f"{to.strftime('%Y-%m-%d %H:%M')}** "
                f"({(to - frm).days} days, times in `{tz}`)")
    report.line(f"* Build query: `{query}`")
    report.line(f"* Grouping: `--group-by {args.group_by}`, line numbers "
                f"{'kept' if args.keep_line_numbers else 'stripped'} from stack frames")
    work_units = sorted({wu for case in cases for entry in (case.get("workUnits") or [])
                         for wu in [_work_unit_name(entry)] if wu})
    if work_units:
        report.line(f"* Work units: {', '.join(f'`{w}`' for w in work_units)}")

    if not executions:
        report.line()
        report.line("**No executions of this test found in the window.** "
                    "Check the container/test name and the project filter.")
        return str(report), {}

    report.line()
    report.line(f"* Executions: **{len(runs)}** "
                f"(passed {sum(1 for e in runs if e['outcome'] == 'passed')}, "
                f"failed {sum(1 for e in runs if e['outcome'] == 'failed')}, "
                f"flaky {sum(1 for e in runs if e['outcome'] == 'flaky')}, "
                f"skipped {sum(1 for e in executions if e['outcome'] == 'skipped')})")
    report.line(f"* Failure rate: **{pct(len(fails), len(runs))}** "
                f"({len(fails)}/{len(runs)})")
    if fails:
        report.line(f"* First failure: {fmt_time(fails[0]['time'], tz)}, "
                    f"last failure: {fmt_time(fails[-1]['time'], tz)} "
                    f"({(to - dt.datetime.fromtimestamp(fails[-1]['time'] / 1000, tz)).days}"
                    f" days ago)")

    all_tags = [set(e["tags"]) for e in executions]
    common_tags = sorted(set.intersection(*all_tags)) if all_tags else []
    if common_tags:
        report.line(f"* Tags on every execution (omitted from the tables below): "
                    f"{', '.join('`' + t + '`' for t in common_tags)}")
    untagged_browser = sum(1 for e in executions
                           if not any(t.lower() in BROWSERS for t in e["tags"]))
    if untagged_browser:
        report.line(f"* {untagged_browser} of {len(executions)} executions carry no "
                    f"browser tag; they run the default browser and are counted as "
                    f"`{IMPLICIT_BROWSER}`.")
    report.line("* A `flaky` execution is one that Develocity classified as flaky "
                "instead of failed in its cross-build test statistics. Despite "
                "Develocity's definition of the term (failed, then passed on retry "
                "within the same build), it does not mean that here: XWiki retries "
                "no test, and the builds behind such an execution ran it exactly "
                "once and report it as a plain failure. It is therefore counted as "
                "a failure below, a `pass` always means a clean run.")
    report.line()

    cases_seen = sorted({e["test"] for e in executions})
    findings = key_findings(ordered, by_config, signals, change, fails, runs,
                            to_ms, tz, multi_case=len(cases_seen) > 1)
    if findings:
        report.line("## Key findings")
        report.line()
        for finding in findings:
            report.line(f"* {finding}")
        report.line()

    if len(cases_seen) > 1:
        report.line("## Test cases in this container")
        report.line()
        rows = []
        for case_name in cases_seen:
            subset = [e for e in executions if e["test"] == case_name]
            stats = config_stats(subset)
            rows.append([case_name, str(stats["runs"]), str(stats["fail_count"]),
                         pct(stats["fail_count"], stats["runs"])])
        report.table(["test case", "runs", "failures", "fail %"], rows, "lrrr")

    # ---------------- section 1: configurations ---------------- #
    report.line("## 1. Configurations (tag combinations)")
    report.line()
    report.line("`span` = between the first and the last failure in this "
                "configuration. Read `pass after` against the configuration's own "
                "`fail %`: at a 10% failure rate a run of 5 passes happens 59% of "
                "the time by chance, so only a streak far longer than 1/`fail %` "
                "says anything about the failure being gone.")
    report.line()
    rows = []
    for config in sorted(by_config, key=lambda c: (
            -config_stats(by_config[c])["fail_count"], c)):
        subset = by_config[config]
        stats = config_stats(subset)
        labels = sorted({groups[e["signature"]]["label"] for e in subset
                         if e["outcome"] in ("failed", "flaky")
                         and e.get("signature") in groups},
                        key=lambda l: int(l[1:]))
        last = stats["last_run"]
        if last:
            verdict = "FAIL" if last["outcome"] in ("failed", "flaky") else "pass"
            last_run = f"{verdict} {fmt_date(last['time'], tz)}"
        else:
            last_run = "-"
        rows.append([
            config, str(stats["runs"]), str(stats["fail_count"]),
            pct(stats["fail_count"], stats["runs"]),
            fmt_date(stats["first_fail"], tz), fmt_date(stats["last_fail"], tz),
            str(stats["fail_in_span"]), str(stats["pass_in_span"]),
            str(stats["pass_before"]), str(stats["pass_after"]),
            str(stats["longest_streak"]), last_run,
            ",".join(labels) or "-",
        ])
    report.table(["configuration (branch / browser / db / servlet)", "runs", "fails",
                  "fail %", "first fail", "last fail", "fails in span",
                  "pass in span", "pass before", "pass after", "max streak",
                  "last run", "failures"],
                 rows, "lrrrllrrrrrll")

    if not fails:
        report.line("**No failures in this window.**")
        return str(report), {"groups": [], "configs": {}}

    # ---------------- section 2: distinct failures ---------------- #
    report.line("## 2. Distinct failures")
    report.line()
    report.line("Failures are grouped by normalised message and stack trace: object "
                "hashes, lambda names, session ids, host names, temp paths, "
                "versions, timestamps and long numbers are replaced by placeholders, "
                "and environment boilerplate (`Build info:`, `Capabilities {…}`, "
                "`(Session info: chrome=…)`, …) is dropped. Frames that only build "
                "the exception (reflection, WebDriver error decoding) are dropped "
                "from the stack, and the detail message of exceptions whose wording "
                "is purely driver-specific (`StaleElementReferenceException`) is "
                "ignored, so the same failure groups across browsers. In each "
                "per-configuration table below, `pass "
                "before`/`pass after` count clean runs in that configuration before "
                "the first and after the last occurrence of *this* failure.")
    report.line()
    if args.artifacts > 0:
        report.line(f"Each failure also lists the screenshot and the video that "
                    f"Jenkins archived for up to {args.artifacts} of its most recent "
                    f"occurrences, picked in as many different configurations "
                    f"(browsers first) as it happened in. Jenkins discards the "
                    f"artifacts of old builds, so a failure that stopped happening "
                    f"weeks ago usually has none left. The videos are Flash "
                    f"recordings (`.flv`): download them and open them in a video "
                    f"player.")
        report.line()
    stack_collisions: dict[str, list[str]] = defaultdict(list)
    for group in ordered:
        stack_sig = group["executions"][0].get("stack_signature")
        if stack_sig:
            stack_collisions[stack_sig].append(group["label"])
    by_label = {g["label"]: g for g in ordered}
    shared = [labels for labels in stack_collisions.values() if len(labels) > 1]
    if shared and args.group_by != "stack":
        for labels in shared:
            raw_stacks = {by_label[l]["executions"][-1]["stack"] for l in labels}
            hint = ("`--group-by stack` merges them"
                    if len(raw_stacks) == 1 else
                    "they fail at different source lines, so `--keep-line-numbers` "
                    "keeps them apart even with `--group-by stack`")
            report.line(f"* {', '.join(labels)} have the same normalised stack trace "
                        f"and differ only in the message — {hint}.")
        report.line()

    for group in ordered:
        members = group["executions"]
        where = (f"`{members[0]['test']}` — " if len(cases_seen) > 1 else "")
        report.line(f"### {group['label']} — {where}`{group['exception']}` "
                    f"({len(members)} failures, {pct(len(members), len(fails))} "
                    f"of all failures)")
        report.line()
        report.line(f"* First: {fmt_time(members[0]['time'], tz)} · "
                    f"Last: {fmt_time(members[-1]['time'], tz)} · "
                    f"Configurations: {len({m['config'] for m in members})} · "
                    f"Signature: `{group['signature']}`")
        only = sum(1 for m in members if m.get("build_test_failures", 0) <= 1)
        others = sorted(
            (m.get("build_test_failures", 0) - 1 for m in members), reverse=True)
        median_others = others[len(others) // 2] if others else 0
        report.line(f"* Sole test failure in its build: {only}/{len(members)} "
                    f"(median other test failures in the same build: {median_others})")
        co_failing = Counter(name for m in members for name in m.get("co_failing", []))
        if co_failing:
            report.line("* Frequently failing together (sampled from the same builds): "
                        + ", ".join(f"`{name}` ×{count}"
                                    for name, count in co_failing.most_common(5)))
        # Variants expose what the grouping deliberately ignores: the source line
        # that failed (stripped from the stack so a failure groups across
        # branches) and, with --group-by stack, the differing assertion messages.
        variants: dict[tuple[str, str], list[dict]] = defaultdict(list)
        for member in members:
            variants[(member.get("site", "(unknown)"),
                      member.get("norm_message", ""))].append(member)
        ranked = sorted(variants.items(), key=lambda kv: -len(kv[1]))
        sites = Counter(member.get("site", "(unknown)") for member in members)
        report.line("* Failed at: " + ", ".join(f"`{site}` ×{count}"
                                                for site, count in sites.most_common(6))
                    + (" …" if len(sites) > 6 else ""))
        report.line()
        if len(ranked) > 1:
            report.line(f"{len(ranked)} distinct errors are merged into this group "
                        f"(same failure after normalisation, but a different "
                        f"assertion message or source line):")
            report.line()
            rows = []
            for (site, _), hits in ranked[:args.max_variants]:
                rows.append([str(len(hits)), site, fmt_date(hits[0]["time"], tz),
                             fmt_date(hits[-1]["time"], tz),
                             truncate(hits[-1].get("raw_message") or "(no message)",
                                      args.variant_chars)])
            report.table(["count", "failed at", "first", "last",
                          "message (most recent occurrence)"], rows, "rllll")
            if len(ranked) > args.max_variants:
                report.line(f"_({len(ranked) - args.max_variants} rarer variants not "
                            f"shown, raise `--max-variants`.)_")
                report.line()
        newest = members[-1]
        report.line("<details><summary>Representative failure (most recent "
                    f"occurrence, {fmt_time(newest['time'], tz)})</summary>")
        report.line()
        report.line("```")
        body = newest["message"] or "(no message)"
        report.line(truncate(body, args.message_chars))
        if newest["stack"]:
            report.line(truncate(newest["stack"].rstrip(), args.stack_chars))
        report.line("```")
        report.line("</details>")
        report.line()
        by_group_config: dict[str, list[dict]] = defaultdict(list)
        for member in members:
            by_group_config[member["config"]].append(member)
        rows = []
        for config in sorted(by_group_config,
                             key=lambda c: -len(by_group_config[c])):
            hits = by_group_config[config]
            all_runs = [e for e in by_config[config] if e["outcome"] in RUN_OUTCOMES]
            stats = config_stats(by_config[config], group_filter=group["signature"])
            rows.append([config, str(len(hits)),
                         fmt_time(hits[0]["time"], tz), fmt_time(hits[-1]["time"], tz),
                         pct(len(hits), len(all_runs)),
                         str(stats["pass_before"]), str(stats["pass_after"])])
        report.table(["configuration", "count", "first", "last",
                      "of runs in that config", "pass before", "pass after"],
                     rows, "lrllrrr")
        recent = list(reversed(members))[:args.top_scans]
        report.line("Recent build scans: " + ", ".join(
            f"[{fmt_date(m['time'], tz)}]({scan_url}{m['scan_id']})" for m in recent))
        report.line()
        found = group.get("artifacts") or []
        if found:
            report.line("Screenshots and videos archived by Jenkins:")
            report.line()
            for entry in found:
                links = []
                if entry["screenshot"]:
                    links.append(f"[screenshot]({entry['screenshot']})")
                if entry["video"]:
                    links.append(f"[video]({entry['video']})")
                links.append(f"[build]({entry['build_url']})")
                report.line(f"* {fmt_time(entry['time'], tz)} · `{entry['config']}` "
                            f"— " + " · ".join(links))
            report.line()
        elif group.get("artifact_attempts"):
            report.line(f"_No screenshot or video found on Jenkins for the "
                        f"{group['artifact_attempts']} most recent occurrence(s) — "
                        f"either this is not a UI test, or Jenkins has already "
                        f"discarded the artifacts of those builds._")
            report.line()

    # ---------------- section 3: per-tag analysis ---------------- #
    report.line("## 3. Per-tag breakdown")
    report.line()
    report.line("Each dimension independently: how often the test ran with that "
                "tag value and how many failures of each group happened there. "
                "A group concentrated in one value points at a "
                "configuration-specific problem.")
    report.line()
    if len(shown_groups) < len(ordered):
        report.line(f"Only the {len(shown_groups)} most frequent failures get a "
                    f"column below.")
        report.line()
    for dimension in DIMENSION_ORDER:
        data = breakdown[dimension]
        values = data["values"]
        if len(values) < 2 and dimension not in ("branch", "browser"):
            continue
        report.line(f"### {dimension}")
        report.line()
        if data["too_granular"]:
            report.line(f"_Skipped: {len(values)} distinct values for {len(runs)} "
                        f"executions — too granular to aggregate._")
            report.line()
            continue
        headers = ["value", "runs", "fails", "fail %"] + [g["label"]
                                                         for g in shown_groups]
        rows = []
        for value in sorted(values, key=lambda v: -len(values[v])):
            subset = values[value]
            subset_fails = [e for e in subset if e["outcome"] in ("failed", "flaky")]
            row = [value, str(len(subset)), str(len(subset_fails)),
                   pct(len(subset_fails), len(subset))]
            for group in shown_groups:
                count = sum(1 for e in subset_fails
                            if e.get("signature") == group["signature"])
                row.append(str(count) if count else "·")
            rows.append(row)
        report.table(headers, rows, "lrrr" + "r" * len(shown_groups))

    if signals:
        report.line("### Concentration signals")
        report.line()
        report.line("Tag values in which one failure is over-represented "
                    "(one-sided Fisher exact test, uncorrected p-values — treat as "
                    "hints, not proof). Values that are merely correlated with a "
                    "stronger signal, because they always occur together with it, "
                    "are left out:")
        report.line()
        for signal in signals:
            report.line(f"* {describe_signal(signal)}")
        report.line()

    # ---------------- section 4: trend ---------------- #
    report.line("## 4. Trend over time")
    report.line()
    weeks = max(1, math.ceil((to_ms - frm_ms) / (7 * 24 * 3600 * 1000)))
    buckets = weekly_buckets(executions, to_ms, weeks)
    headers = ["7-day window", "runs", "fails", "fail %"] + [g["label"]
                                                            for g in shown_groups]
    rows = []
    for bucket in buckets:
        inside = bucket["executions"]
        bucket_fails = [e for e in inside if e["outcome"] in ("failed", "flaky")]
        row = [f"{fmt_date(bucket['lo'], tz)} → {fmt_date(bucket['hi'], tz)}",
               str(len(inside)), str(len(bucket_fails)),
               pct(len(bucket_fails), len(inside))]
        for group in shown_groups:
            count = sum(1 for e in bucket_fails
                        if e.get("signature") == group["signature"])
            row.append(str(count) if count else "·")
        rows.append(row)
    report.table(headers, rows, "lrrr" + "r" * len(shown_groups))

    for index in range(1, len(buckets)):
        previous, current = buckets[index - 1], buckets[index]
        n1 = len([e for e in previous["executions"] if e["outcome"] in RUN_OUTCOMES])
        n2 = len([e for e in current["executions"] if e["outcome"] in RUN_OUTCOMES])
        f1 = len([e for e in previous["executions"]
                  if e["outcome"] in ("failed", "flaky")])
        f2 = len([e for e in current["executions"]
                  if e["outcome"] in ("failed", "flaky")])
        p = fisher_two_proportions(f1, n1, f2, n2)
        if p < 0.05:
            direction = "increase" if (f2 / n2 if n2 else 0) > (f1 / n1 if n1 else 0) \
                else "decrease"
            report.line(f"* Significant {direction} in week starting "
                        f"{fmt_date(current['lo'], tz)}: {f1}/{n1} → {f2}/{n2} "
                        f"(p={p:.2g})")
    points = rolling_rates(executions, frm_ms, to_ms)
    if points:
        report.line(f"* Rolling 7-day failure rate (1-day step, "
                    f"{fmt_date(points[0]['hi'], tz)} → "
                    f"{fmt_date(points[-1]['hi'], tz)}): "
                    f"`{sparkline(p['rate'] for p in points)}` "
                    f"min {min(p['rate'] for p in points) * 100:.1f}%, "
                    f"max {max(p['rate'] for p in points) * 100:.1f}%")
    if change:
        report.line(
            f"* Most significant change point: "
            f"{fmt_date(change['cut'], tz)} — "
            f"{change['before_fails']}/{change['before_runs']} "
            f"({pct(change['before_fails'], change['before_runs'])}) before vs "
            f"{change['after_fails']}/{change['after_runs']} "
            f"({pct(change['after_fails'], change['after_runs'])}) after, "
            f"p={change['p']:.2g} "
            f"(adjusted for {change['tests']} candidate splits: "
            f"{change['p_adjusted']:.2g})")
    report.line()

    report.line(f"_Generated by `dv-test-history` with {dv.request_count} "
                f"Develocity request{'' if dv.request_count == 1 else 's'}"
                + (f" and {jenkins.request_count} Jenkins request"
                   f"{'' if jenkins.request_count == 1 else 's'}"
                   if jenkins.request_count else "") + "._")

    machine = {
        "container": container,
        "test": test_filter,
        "window": {"from": frm.isoformat(), "to": to.isoformat()},
        "query": query,
        "totals": {
            "runs": len(runs),
            "failures": len(fails),
            "passed": sum(1 for e in runs if e["outcome"] == "passed"),
            "flaky": sum(1 for e in runs if e["outcome"] == "flaky"),
        },
        "groups": [{
            "label": g["label"],
            "signature": g["signature"],
            "exception": g["exception"],
            "count": len(g["executions"]),
            "first": g["executions"][0]["time"],
            "last": g["executions"][-1]["time"],
            "normalised_message": g["executions"][-1]["norm_message"],
            "normalised_stack": g["executions"][-1]["norm_stack"],
            "sites": dict(Counter(m.get("site", "(unknown)")
                                  for m in g["executions"])),
            "artifacts": g.get("artifacts") or [],
            "occurrences": [{
                "scan_id": m["scan_id"], "time": m["time"], "config": m["config"],
                "tags": m["tags"], "test": m["test"], "site": m.get("site"),
                "message": m.get("raw_message"),
                "build_test_failures": m.get("build_test_failures"),
            } for m in g["executions"]],
        } for g in ordered],
        "configs": {config: config_stats(subset)
                    for config, subset in by_config.items()},
    }
    for stats in machine["configs"].values():
        stats.pop("last_run", None)
    return str(report), machine


def report_recent_failures(dv: Develocity, cache: Cache, args, frm: dt.datetime,
                           to: dt.datetime, tz, project: str | None) -> str:
    """List the tests that failed recently, as candidates for a full analysis."""
    report = Report()
    recent_query = build_query(frm, to, project, args.query)
    containers = fetch_failing_containers(dv, recent_query)

    def cases_of(container: str, query: str) -> tuple[str, list[dict]]:
        return container, fetch_test_cases(dv, container, query)

    names = [c["name"] for c in containers]
    recent: dict[str, list[dict]] = {}
    if names:
        with ThreadPoolExecutor(max_workers=args.jobs) as pool:
            for container, cases in pool.map(
                    lambda n: cases_of(n, recent_query), names):
                recent[container] = cases

    # One extra request per container tells us whether a failure is new; without
    # it every flaky old-timer looks as urgent as a fresh regression.
    baseline: dict[str, dict[str, dict]] = {}
    baseline_from = frm - dt.timedelta(days=args.baseline_days)
    if args.baseline_days > 0 and names:
        baseline_query = build_query(baseline_from, frm, project, args.query)
        with ThreadPoolExecutor(max_workers=args.jobs) as pool:
            for container, cases in pool.map(
                    lambda n: cases_of(n, baseline_query), names):
                baseline[container] = {c["name"]: c.get("outcomeDistribution") or {}
                                       for c in cases}

    candidates = []
    for container, cases in recent.items():
        for case in cases:
            distribution = case.get("outcomeDistribution") or {}
            failed = distribution.get("failed", 0)
            flaky = distribution.get("flaky", 0)
            if not failed and not flaky:
                continue
            by_outcome = case.get("buildScanIdsByOutcome") or {}
            full_name = case.get("name", "")
            candidates.append({
                "container": container,
                "case": full_name.rsplit(".", 1)[-1],
                "failed": failed,
                "flaky": flaky,
                "runs": sum(distribution.get(o, 0) for o in RUN_OUTCOMES),
                "scans": list(by_outcome.get("failed", []))
                + list(by_outcome.get("flaky", [])),
                "baseline": baseline.get(container, {}).get(full_name),
            })

    scan_ids = sorted({s for c in candidates for s in c["scans"]})
    attributes = (fetch_build_attributes(dv, cache, scan_ids, frm, to)
                  if scan_ids else {})
    for candidate in candidates:
        times, tags = [], []
        for scan_id in candidate["scans"]:
            attrs = attributes.get(scan_id)
            if not attrs:
                continue
            if attrs.get("start_time"):
                times.append(attrs["start_time"])
            tags.append(dimensions(attrs["tags"], attrs.get("jvm", ""),
                                   attrs.get("host", "")))
        candidate["last"] = max(times) if times else None
        candidate["branches"] = sorted({d["branch"] for d in tags})
        candidate["browsers"] = sorted({d["browser"] for d in tags})
        distribution = candidate["baseline"]
        if args.baseline_days <= 0:
            # Without the baseline request we cannot tell new from long-known.
            candidate["status"] = "?"
            candidate["baseline_text"] = "-"
        elif distribution is None:
            # The test did not run at all before this window.
            candidate["status"] = "new"
            candidate["baseline_text"] = "never ran"
        else:
            base_fails = (distribution.get("failed", 0)
                          + distribution.get("flaky", 0))
            base_runs = sum(distribution.get(o, 0) for o in RUN_OUTCOMES)
            candidate["status"] = "new" if base_fails == 0 else "known"
            candidate["baseline_text"] = (f"{base_fails}/{base_runs} "
                                          f"({pct(base_fails, base_runs)})")

    candidates.sort(key=lambda c: (c["status"] == "known",
                                   -(c["failed"] + c["flaky"]), c["container"]))

    hours = (to - frm).total_seconds() / 3600
    report.line(f"# Tests that failed in the last {hours:g} "
                f"hour{'' if hours == 1 else 's'}")
    report.line()
    report.line(f"* Window: **{frm.strftime('%Y-%m-%d %H:%M')} → "
                f"{to.strftime('%Y-%m-%d %H:%M')}** (times in `{tz}`)")
    report.line(f"* Build query: `{recent_query}`")
    report.line(f"* {len(candidates)} failing test case(s) in "
                f"{len(recent)} container(s).")
    report.line()
    if not candidates:
        report.line("**No test failed in this window.**")
        return str(report)

    report.line("Columns:")
    report.line()
    report.line("* `fails`, `flaky`, `runs`, `fail %` count executions **inside the "
                "window above**: `runs` is how often the test ran at all there, "
                "`flaky` how often Develocity classified a failure of it as flaky "
                "rather than failed (XWiki retries no test, so such a run failed "
                "too — it is just counted in another column), and `fail %` = "
                "(`fails` + `flaky`) / `runs`.")
    if args.baseline_days > 0:
        report.line(f"* `baseline` counts the same thing in the **{args.baseline_days:g} "
                    f"days before** the window ({baseline_from.strftime('%Y-%m-%d')} → "
                    f"{frm.strftime('%Y-%m-%d')}), as `failures/runs` and their "
                    f"percentage. It is a different, longer time range than `runs`, so "
                    f"compare only the percentages: a `fail %` well above the baseline "
                    f"percentage means the failure got worse, a similar one means it "
                    f"has been flickering all along.")
        report.line("* `status` is `new` when the test never failed in that baseline "
                    "range (`never ran` when it did not run either) and `known` when "
                    "it already failed there. New failures are listed first.")
    else:
        report.line("* There is no `status`/`baseline` column: `--baseline-days 0` "
                    "skipped the comparison with the preceding days that tells a "
                    "fresh regression from a long-known flicker.")
    report.line()

    with_status = args.baseline_days > 0
    rows = []
    for candidate in candidates:
        total = candidate["failed"] + candidate["flaky"]
        rows.append(([candidate["status"]] if with_status else []) + [
            str(candidate["failed"]),
            str(candidate["flaky"]),
            str(candidate["runs"]),
            pct(total, candidate["runs"]),
        ] + ([candidate["baseline_text"]] if with_status else []) + [
            fmt_time(candidate["last"], tz),
            ", ".join(candidate["branches"]) or "-",
            ", ".join(candidate["browsers"]) or "-",
            f"{candidate['container'].rsplit('.', 1)[-1]}#{candidate['case']}",
        ])
    report.table((["status"] if with_status else [])
                 + ["fails", "flaky", "runs", "fail %"]
                 + (["baseline fails/runs"] if with_status else [])
                 + ["last failure", "branches", "browsers", "test"], rows,
                 ("l" if with_status else "") + "rrrr"
                 + ("r" if with_status else "") + "llll")

    # Suggest every new failure, then fill up with the most frequent known ones.
    suggested = [c for c in candidates if c["status"] == "new"]
    suggested += [c for c in candidates if c["status"] != "new"][
        :max(0, MAX_SUGGESTIONS - len(suggested))]
    report.line("Analyse one of them with:")
    report.line()
    report.line("```zsh")
    for candidate in suggested[:MAX_SUGGESTIONS]:
        report.line(f"dv-test-history '{candidate['container']}"
                    f"#{candidate['case']}'")
    report.line("```")
    report.line()
    report.line(f"_Generated by `dv-test-history` with {dv.request_count} "
                f"Develocity request{'' if dv.request_count == 1 else 's'}._")
    return str(report)


def _work_unit_name(entry: dict) -> str:
    for tool, data in entry.items():
        if not isinstance(data, dict):
            continue
        if "goalName" in data:
            return (f"{data.get('groupId','')}:{data.get('artifactId','')}:"
                    f"{data.get('goalName','')}"
                    + (f"@{data['executionId']}" if data.get("executionId") else ""))
        if "taskPath" in data:
            return data["taskPath"]
        return json.dumps(data)
    return ""


